# Produktions-Stack
COMPOSE_PROJECT_NAME=fahrtenbuch-custom
CONTAINER_NAME=fahrtenbuch-custom
IMAGE_NAME=fahrtenbuch-local
IMAGE_TAG=latest
IMAGE_TITLE="Fahrtenbuch Custom"
# Optionaler Build-Override; normalerweise auskommentiert lassen.
# BUILD_VERSION=
APP_REVISION=local
SOURCE_URL=https://github.com/CelduinX/fahrtenbuch
BIND_ADDRESS=0.0.0.0
APP_PORT=1357
DATA_DIR=./data
TZ=Europe/Berlin

# Entwicklungs-Stack
DEV_CONTAINER_NAME=fahrtenbuch-custom-dev
DEV_IMAGE_NAME=fahrtenbuch-local-dev
DEV_BIND_ADDRESS=0.0.0.0
DEV_APP_PORT=3001
DEV_DATA_DIR=./data-dev

# auto = HTTPS anhand X-Forwarded-Proto erkennen; true/false erzwingt die Einstellung
SESSION_COOKIE_SECURE=auto
